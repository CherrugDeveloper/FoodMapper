                </button>
              </div>
            </div>
          </div>
        )}

        {/* Conferma reset giornata */}
        {confirmResetDay && (
          <div className="fixed inset-0 bg-black/50 flex items-center justify-center z-50">
            <div className="bg-(--bg) border border-(--border) rounded-2xl p-6 max-w-sm mx-4 shadow-xl">
