    },
    steps: {
      it: ['5 min di riscaldamento a passo lento', '20-40 min a passo veloce', '5 min di defaticamento'],
      en: ['5 min slow warm-up', '20-40 min fast pace', '5 min cool-down']
    }
  },
  strength: {
