        </section>

        {/* Note */}
        <section className="p-4 rounded-2xl bg-(--bg) border border-(--border) shadow-sm">
          <h3 className="text-base font-bold text-(--text-h) mb-2">📝 {t('diary_notes_title')}</h3>
          <textarea
